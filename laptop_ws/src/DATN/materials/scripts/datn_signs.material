material DATN/SignTurnLeft
{
  technique
  {
    pass
    {
      lighting off
      scene_blend alpha_blend
      alpha_rejection greater 128
      cull_hardware none
      cull_software none
      texture_unit
      {
        texture turn_left.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

